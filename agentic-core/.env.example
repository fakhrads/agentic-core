# --- Core service identity ---
AGENT_ENV=dev
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=./logs

# --- Redis (event bus + quota + revocation) ---
AGENT_REDIS_URL=redis://localhost:6379/0

# --- Postgres + pgvector (episodic/semantic memory, skills, benchmarks) ---
AGENT_POSTGRES_DSN=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- DeepSeek (planning / big model). Separate client, separate auth+timeout. ---
AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_DEEPSEEK_API_KEY=
AGENT_DEEPSEEK_MODEL=deepseek-chat
AGENT_DEEPSEEK_TIMEOUT_S=60

# --- Ollama (embeddings + cheap probe model). Local. ---
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_EMBED_MODEL=nomic-embed-text
AGENT_OLLAMA_PROBE_MODEL=qwen2.5:3b
AGENT_OLLAMA_TIMEOUT_S=30

# --- Tools backend (contract v1, behind Traefik ForwardAuth). Separate client. ---
AGENT_TOOLS_BASE_URL=http://localhost:8080
AGENT_TOOLS_SERVICE_TOKEN=svc_replace_me
# Separate token with tools:register scope (tool forge only). Never the invoke token.
AGENT_TOOLS_FORGE_TOKEN=
AGENT_TOOLS_TIMEOUT_S=20
AGENT_CONTRACT_VERSION=1

# --- External content fetch client. NEVER carries a service token. ---
AGENT_FETCH_TIMEOUT_S=20
# Comma-separated URLs the night shift fetches into quarantine (research).
AGENT_RESEARCH_SOURCES=

# --- Telegram channel ---
AGENT_TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_ALLOWED_CHAT_IDS=

# --- Daily autonomy budget ---
AGENT_BUDGET_TOKENS=500000
AGENT_BUDGET_COST_USD=2.00
AGENT_BUDGET_ACTIONS=200

# --- Backpressure ---
AGENT_MAX_QUEUE=100
