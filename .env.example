# agent-core configuration. Copy to `.env` and fill in — or just run
# `agent setup`, which writes this file interactively.
#
# Legend: [required] must be set for the agent to be useful.
#         [default]  fine to leave as-is for local dev.
#         [optional] soft dependency — the agent boots without it; the
#                     feature it powers just no-ops until it's set.

# --- Core ---------------------------------------------------------------
AGENT_ENV=dev
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=./logs

# HTTP health/metrics/status surface (agent up).      [default]
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=8099

# --- Redis + Postgres — start both via `docker compose up -d`. [default: docker-compose.yml]
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_POSTGRES_DSN=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- Primary LLM provider ------------------------------------------------
# DeepSeekProvider is OpenAI-wire-compatible, so these fields work for any
# OpenAI-compatible endpoint (OpenAI, OpenRouter, DeepSeek, a local
# vLLM/llama.cpp server, ...). Switch providers anytime with `agent model set`.
AGENT_LLM_PROVIDER=deepseek                          # [default] cosmetic label, used for cost lookup
AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com     # [required]
AGENT_DEEPSEEK_API_KEY=                              # [required]
AGENT_DEEPSEEK_MODEL=deepseek-chat                   # [required]
AGENT_DEEPSEEK_TIMEOUT_S=60.0

# --- Ollama — local embeddings + cheap probe model ----------------------
AGENT_OLLAMA_BASE_URL=http://localhost:11434         # [required] `ollama serve` running locally
AGENT_OLLAMA_EMBED_MODEL=nomic-embed-text
AGENT_OLLAMA_PROBE_MODEL=qwen2.5:3b
AGENT_OLLAMA_TIMEOUT_S=30.0

# --- Tools backend (contract v1) -----------------------------------------
AGENT_TOOLS_BASE_URL=http://localhost:8080           # [optional]
AGENT_TOOLS_SERVICE_TOKEN=svc_replace_me             # [optional]
AGENT_TOOLS_FORGE_TOKEN=                             # [optional] separate scope, never the invoke token
AGENT_TOOLS_TIMEOUT_S=20.0
AGENT_CONTRACT_VERSION=1

# --- External content ingest (night shift research) ----------------------
AGENT_FETCH_TIMEOUT_S=20.0
AGENT_RESEARCH_SOURCES=                              # [optional] comma-separated URLs

# --- Telegram -------------------------------------------------------------
AGENT_TELEGRAM_BOT_TOKEN=                            # [optional] leave empty to disable
AGENT_TELEGRAM_ALLOWED_CHAT_IDS=                     # [optional] comma-separated chat ids; empty = allow all

# --- WhatsApp (unofficial, via the local whatsapp-bridge/ Baileys sidecar) --
# No Meta Business account needed — run `cd whatsapp-bridge && npm install &&
# npm start` and scan the QR code. Leave AGENT_WHATSAPP_BRIDGE_SECRET empty to
# disable; when set, it must match BRIDGE_SECRET in whatsapp-bridge/.env.
AGENT_WHATSAPP_BRIDGE_URL=http://127.0.0.1:8098      # [default]
AGENT_WHATSAPP_BRIDGE_SECRET=                        # [optional] leave empty to disable
AGENT_WHATSAPP_ALLOWED_NUMBERS=                      # [optional] comma-separated numbers; empty = allow all

# --- Daily autonomy budget -------------------------------------------------
AGENT_BUDGET_TOKENS=500000
AGENT_BUDGET_COST_USD=2.00
AGENT_BUDGET_ACTIONS=200

# --- Backpressure -----------------------------------------------------------
AGENT_MAX_QUEUE=100

# --- Playbook (MEMORY.md / USER.md / SELF.md) --------------------------------
AGENT_PLAYBOOK_DIR=./playbook
